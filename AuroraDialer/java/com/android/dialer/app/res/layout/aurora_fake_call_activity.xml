  Layout modelled on the dashboard of Phony (github.com/DDOneApps/Phony, GPL-3.0):
  a headline with subtitle, warning cards for anything that has to be fixed first, grouped cards for
  the caller, the timing, the audio and the keypad, and one primary action at the bottom.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aurora_fake_call_title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:text="@string/aurora_fake_call_intro"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <!-- Warning card: something has to be fixed before a call can be placed (Phony's warning card). -->
        <LinearLayout
            android:id="@+id/fake_call_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/aurora_fake_call_notice"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fake_call_notice_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/fake_call_notice_alarms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:text="@string/aurora_fake_call_notice_alarms_action"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/fake_call_notice_accounts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:text="@string/aurora_fake_call_notice_accounts_action"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/fake_call_notice_battery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:text="@string/aurora_fake_call_notice_battery_action"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Caller card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/aurora_fake_call_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/aurora_fake_call_section_caller"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@+id/fake_call_name"
                android:paddingBottom="4dp"
                android:text="@string/aurora_fake_call_name_label"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <EditText
                android:id="@+id/fake_call_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/aurora_fake_call_field"
                android:hint="@string/aurora_fake_call_name_hint"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@+id/fake_call_number"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:text="@string/aurora_fake_call_number_label"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <EditText
                android:id="@+id/fake_call_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/aurora_fake_call_field"
                android:hint="@string/aurora_fake_call_number_hint"
                android:inputType="phone"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Timing card: countdown or an exact clock time (Phony's schedule section) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/aurora_fake_call_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/aurora_fake_call_section_schedule"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/fake_call_kind_countdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:text="@string/aurora_fake_call_kind_countdown"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/fake_call_kind_exact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:text="@string/aurora_fake_call_kind_exact"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Countdown mode -->
            <LinearLayout
                android:id="@+id/fake_call_countdown_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="6dp"
                    android:text="@string/aurora_fake_call_delay_label"
                    android:textAppearance="?android:attr/textAppearanceSmall" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/fake_call_delay_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Exact-time mode -->
            <LinearLayout
                android:id="@+id/fake_call_exact_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/fake_call_exact_time"
                    android:paddingBottom="6dp"
                    android:text="@string/aurora_fake_call_exact_time_label"
                    android:textAppearance="?android:attr/textAppearanceSmall" />

                <Button
                    android:id="@+id/fake_call_exact_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/aurora_fake_call_field"
                    android:minHeight="52dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="@string/aurora_fake_call_exact_time_hint"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="6dp"
                android:text="@string/aurora_fake_call_ring_timeout_label"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/fake_call_ring_timeout_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Audio card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/aurora_fake_call_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/aurora_fake_call_section_audio"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fake_call_audio_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/aurora_fake_call_audio_none"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/fake_call_audio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:text="@string/aurora_fake_call_audio_choose"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/fake_call_audio_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:text="@string/aurora_fake_call_audio_clear"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/fake_call_loop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/aurora_fake_call_audio_loop"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/fake_call_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aurora_fake_call_record_mic"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/fake_call_record_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aurora_fake_call_record_hint"
                android:textAppearance="?android:attr/textAppearanceSmall" />
        </LinearLayout>

        <!-- Keypad card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/aurora_fake_call_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="@string/aurora_fake_call_ivr_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/aurora_fake_call_ivr_hint"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/fake_call_key1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/fake_call_key2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/fake_call_key3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Presets card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/aurora_fake_call_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/aurora_fake_call_presets_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/fake_call_preset1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/fake_call_preset2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/fake_call_preset3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/aurora_fake_call_tonal_button"
                    android:minHeight="44dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Phone account card (Phony: the provider name the call comes through) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/aurora_fake_call_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@+id/fake_call_account_label"
                android:paddingBottom="4dp"
                android:text="@string/aurora_fake_call_account_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/fake_call_account_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/aurora_fake_call_field"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="@string/aurora_fake_call_account_hint"
                android:textAppearance="?android:attr/textAppearanceSmall" />
        </LinearLayout>

        <TextView
            android:id="@+id/fake_call_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:visibility="gone" />

        <Button
            android:id="@+id/fake_call_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/aurora_fake_call_tonal_button"
            android:minHeight="48dp"
            android:stateListAnimator="@null"
            android:text="@string/aurora_fake_call_cancel_scheduled"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/fake_call_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/aurora_fake_call_primary_button"
            android:minHeight="52dp"
            android:stateListAnimator="@null"
            android:text="@string/aurora_fake_call_start"
            android:textAllCaps="false"
            android:textColor="@color/aurora_fake_call_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/fake_call_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:minHeight="44dp"
            android:stateListAnimator="@null"
            android:text="@string/aurora_fake_call_close"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/fake_call_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:minHeight="44dp"
            android:stateListAnimator="@null"
            android:text="@string/aurora_fake_call_diagnostics_title"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
