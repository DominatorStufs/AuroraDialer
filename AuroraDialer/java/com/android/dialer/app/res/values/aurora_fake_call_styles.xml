<resources>
    <!--
      Colours of the simulated-call screen.

      The dialer's own accent is a near-white (#F8F8F8) on its dark theme, which left the platform
      time picker with a washed-out white clock face and made a filled button unreadable, so this
      screen carries its own accent instead of borrowing ?android:attr/colorAccent.
    -->
    <color name="aurora_fake_call_accent">#FF5195EA</color>

    <!-- Text and icons sitting on top of the accent colour. -->
    <color name="aurora_fake_call_on_accent">#FFFFFFFF</color>

    <!-- Dialog surface of the time picker, close to the dialer's own floating background. -->
    <color name="aurora_fake_call_dialog_background">#FF1A1A1A</color>

    <color name="aurora_fake_call_dialog_text">#FFF8F8F8</color>

    <color name="aurora_fake_call_dialog_text_secondary">#B3F8F8F8</color>

    <color name="aurora_fake_call_dialog_text_inverse">#FF101010</color>

    <!--
      Theme for the time picker. Left to itself the framework draws it with the light Material dialog
      colours - a white clock face on a dark screen - so the palette is pinned down here.
    -->
    <style name="AuroraFakeCallTimeDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/aurora_fake_call_dialog_background</item>
        <item name="android:colorBackground">@color/aurora_fake_call_dialog_background</item>
        <item name="android:colorBackgroundFloating">@color/aurora_fake_call_dialog_background</item>
        <item name="android:textColorPrimary">@color/aurora_fake_call_dialog_text</item>
        <item name="android:textColorSecondary">@color/aurora_fake_call_dialog_text_secondary</item>
        <item name="android:textColorPrimaryInverse">@color/aurora_fake_call_dialog_text_inverse</item>
        <item name="android:textColorHint">@color/aurora_fake_call_dialog_text_secondary</item>
        <item name="colorAccent">@color/aurora_fake_call_accent</item>
        <item name="android:colorAccent">@color/aurora_fake_call_accent</item>
        <item name="colorControlActivated">@color/aurora_fake_call_accent</item>
        <item name="android:colorControlActivated">@color/aurora_fake_call_accent</item>
        <item name="android:colorControlHighlight">#335195EA</item>
    </style>
</resources>
